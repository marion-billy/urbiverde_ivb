flowchart TD
    WC["ESA WorldCover 10 m"]
    OSM["`OpenStreetMap
*roads, rail, buildings, water*`"]
    GP["`Ecological profile parameters
*habitat, d0, frictions*`"]

    subgraph P1["1. Land cover"]
        S1["generate_ecoprofil_landcover"]
        C1["`**landcover (.tif)**
*WorldCover codes 10-95 + OSM 51-55*`"]
    end
    subgraph P2["2. Habitat and resistance"]
        S2["`get_binary_habitat
get_connectivity_elements
*cores >= 1 ha, stepping stones 0.1-1 ha*`"]
        S2F["create_resistance_surface"]
        C2["`**binary_habitat (.tif)**
*1 = habitat, 0 = non-habitat*`"]
        C2F["`**friction (.tif)**
*movement cost 1 to 100*`"]
    end
    subgraph P3["3. Graph and connectivity"]
        S3["`build_gabriel_graph, *links <= 2 d0*
graph_to_gdf_edges`"]
        S3P["calculate_pc_index"]
        C3["`**edges (.geojson)**
*node_1, node_2, dist_m, cost_log*`"]
    end
    subgraph P4["4. Least-cost and dispersal"]
        S4["`compute_lcp_network, *budget d0 x 3*
compute_dispersal_surface
soft_retrace_failed + extract_rupture_points
calculate_pc_index_lcp`"]
        C_DISP["`**dispersal_bounded (.tif)**
*accumulated cost from habitat, <= budget*`"]
    end
    subgraph P5["5. Outputs"]
        S5["calculate_edge_dpc / betweenness / classify / pinch<br/>create_corridor_segments + weld<br/>sub-networks + calculate_node_betweenness"]
        O1["`**nodes, isolated_nodes (.geojson)**
*node_type, class, total_area_ha, subnetwork_id*`"]
        O2["`**lcp, failed_links, rupture_points (.geojson)**
*real_dist, tortuosity, fail_reason, obstacle, n_ruptures*`"]
        C_SEG["`**corridor_segments (.geojson)**
*segment_id, corridor_count*`"]
        O4["`**stats (.csv)**
*pc_theory, pc_real, connectivity_loss_pct, n_subnetworks, tortuosity*`"]
    end

    WC --> S1
    OSM --> S1
    GP --> S1
    S1 --> C1
    C1 --> S2
    C1 --> S2F
    S2 --> C2
    S2F --> C2F
    C2 --> S3
    S3 --> C3
    S3 --> S3P
    C3 --> S4
    C2F --> S4
    S4 --> C_DISP
    S3P --> O4
    S4 --> S5
    S5 --> O1
    S5 --> O2
    S5 --> C_SEG
    S5 --> O4

    classDef inp fill:#F2E3C6,stroke:#BE842A,color:#1B2B28;
    classDef step fill:#ECECEC,stroke:#8A8A8A,color:#1B2B28;
    classDef ras fill:#DAE9DF,stroke:#367752,color:#1B2B28;
    classDef vec fill:#D6E4F0,stroke:#2E6DA4,color:#1B2B28;
    classDef csv fill:#F5D9D2,stroke:#C0392B,color:#1B2B28;
    classDef band fill:#FFF6D5,stroke:#D9C27E,color:#5A4A1A,font-size:18px;
    class WC,OSM,GP inp;
    class S1,S2,S2F,S3,S3P,S4,S5 step;
    class C1,C2,C2F,C_DISP ras;
    class C3,O1,O2,C_SEG vec;
    class O4 csv;
    class P1,P2,P3,P4,P5 band;
