# =============================================================================
# corridor_project - .gitignore
# Principe : le depot porte le CODE, la CONFIGURATION et la DOCUMENTATION
# (~2 Mo). Les donnees produites (data/ = 116 Go) et les caches sont diffuses
# separement (archive / stockage objet).
# =============================================================================

# La cle de compte de service Earth Engine est lue via $GEE_KEY_PATH.
credentials/
*credential*.json
*service-account*.json
gee*.json
*.pem
*.key
.env

# --- Donnees et caches ----------------------------
data/*
!data/outputs/
data/outputs/*
!data/outputs/README.md
!data/outputs/species_params.csv
!data/sensitivity/
data/sensitivity/*
!data/sensitivity/sensitivity_annexe.md
!data/sensitivity/sensitivity_summary.csv
!data/sensitivity/grid3x3_anova.csv
!data/sensitivity/grid5x5_anova.csv

cache/
lc_cache/

# --- Sorties de travail exploratoire -----------------------------------------
_sandbox/logs/
_sandbox/gbif_validation/cache/
_sandbox/figures_sens/
_sandbox/__pycache__/
_sandbox/*.log
_sandbox/*.out
_sandbox/*.flag

# --- Artefacts Python --------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# --- Divers ------------------------------------------------------------------
.nfs*
.DS_Store
Thumbs.db
*.tmp
papier/internship_report/rapport.pdf

# --- Kept on disk but out of the repo (internship deliverables, tracking, scratch, notebooks) ---
papier/
suivi/
_sandbox/
/*.ipynb
